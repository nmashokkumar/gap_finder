# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing & coverage
/coverage

# next.js build outputs
/.next/
/out/
/build

# Python artifacts (virtual environments, caches, bytecode)
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# environment variables (NEVER COMMIT API KEYS)
.env
.env*.local
.env.local
.env.production
.env.development

# OS & editor metadata
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/

# npm/yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# typescript build cache
*.tsbuildinfo
next-env.d.ts
